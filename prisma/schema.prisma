generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Auth {
  id                String   @id @default(uuid())
  email             String
  password          String
  role              Role     @default(MEMBER)
  isActive          Boolean  @default(true)
  isDeleted         Boolean  @default(false)
  isVerified        Boolean  @default(false)
  
  last_loginAt      DateTime @default(now())
  passwordChangedAt DateTime @default(now())

  // devices String[]

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auths")
}

enum Role {
  ADMIN
  MEMBER
  MANAGER
}

model OtpRequest {
  id          String   @id @default(uuid())
  code        String
  createdAt   DateTime @default(now())
  expiredAt   DateTime
  isVerified  Boolean  @default(false)
  type        Otp_type @default(REGISTER)
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  verifiedAt DateTime?

  @@index([userId])
  @@index([type])
}

enum Otp_type {
  REGISTER
  CHANGE_EMAIL
  FORGOT_PASSWORD
  MULTI_FACTOR_AUTH
}

model User {
  id        String   @id @default(uuid())
  name      String
  email      String   @unique
  phone      String?
  countries  String[]
  address    String?
  profession String?
  company    String?

  auth Auth?

  notification Boolean @default(true)

  fcmToken String?

  picture ProfilePicture?

  otpRequests OtpRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  notifications Notification[]
  orders Order[]

  @@index([email, isDeleted])
  @@index([id, isDeleted])
  @@index([id, email, isDeleted])
  @@map("users")
}

model ProfilePicture {
  id     String @id @default(uuid())
  url    String
  key    String
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@map("profile_pictures")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  key      String?
  description String?
  services  Serivce[]

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
  @@index([isDeleted])
}

model Variant {
  id        String   @id @default(uuid())
  timeLine  String
  base_price Float
  discount  Float
  final_price Float
  badges VariantBadge[]

  note      String?

  isDeleted Boolean @default(false)

  serviceId String
  service   Serivce  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  accountType AccountType @default(PERSONAL)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("variants")
  @@index([isDeleted, serviceId])
}

enum VariantBadge {
  BEST_VALUE
  MOST_POPULAR
  BEST_SELLER
  BEST_DEAL
  PREMIUM
  RECOMMENDED
  NEW
  LIMITED_STOCK
  TRENDING
  EXCLUSIVE
  SPECIAL_OFFER
  TOP_PICK
}

enum AccountType {
  SHARED
  PERSONAL
}

model Serivce {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  description String
  variants  Variant[]
  note      String?

  images    ServiceImage[]

  minPrice  Float
  maxPrice  Float

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  isDeleted Boolean @default(false)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
  @@index([isDeleted, categoryId])
}

model ServiceImage {
  id        String   @id @default(uuid())
  url       String
  key       String
  serviceId String
  service   Serivce  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
  @@map("service_images")
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  receiverId    String
  user      User     @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiverId])
  @@map("notifications")
}

model Order {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerName String
  customerEmail String
  customerWhatsapp String
  customerNote String?

  items     OrderItem[]

  price     Float

  couponCode String?
  couponDiscount Float @default(0)
  couponApplied Boolean @default(false)

  paymentMethod PaymentMethod @default(BKASH)
  accountNumber String?
  transactionId String

  status    OrderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  serviceId String
  service   Serivce  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity  Int      @default(1)
  unitPrice Float
  totalPrice Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([serviceId])
  @@index([variantId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  CARD
  CASH
}

model Banner {
  id        String   @id @default(uuid())
  url String
  key String
  order Int @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Support {
  id        String   @id @default(uuid())
  name String
  phone String
  email String?
  subject String
  details String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}